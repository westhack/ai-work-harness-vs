{
	"name": "ai-work-harness-vs",
	"displayName": "Ai Work Harness",
	"description": "%extension.description%",
	"version": "0.2.1",
	"publisher": "westhack",
	"license": "MIT",
	"icon": "media/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/westhack/ai-work-harness-vs.git"
	},
	"bugs": {
		"url": "https://github.com/westhack/ai-work-harness-vs/issues"
	},
	"homepage": "https://github.com/westhack/ai-work-harness-vs#readme",
	"engines": {
		"vscode": "^1.96.0"
	},
	"packageManager": "pnpm@12.6.0",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages"
	],
	"keywords": [
		"ai",
		"agent",
		"chat",
		"copilot",
		"assistant"
	],
	"activationEvents": [],
	"main": "./dist/extension.js",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "%capabilities.untrustedWorkspaces.description%"
		},
		"virtualWorkspaces": false
	},
	"contributes": {
		"commands": [
			{
				"command": "aiworkharness.remoteJobs",
				"title": "%command.remoteJobs%"
			},
			{
				"command": "aiworkharness.managePlugins",
				"title": "%command.managePlugins%"
			},
			{
				"command": "aiworkharness.openSettings",
				"title": "%command.openSettings%"
			},
			{
				"command": "aiworkharness.addToChat",
				"title": "%command.addToChat%"
			},
			{
				"command": "aiworkharness.newChat",
				"title": "%command.newChat%"
			},
			{
				"command": "aiworkharness.reviewChanges",
				"title": "%command.reviewChanges%"
			},
			{
				"command": "aiworkharness.implementTodo",
				"title": "%command.implementTodo%"
			}
		],
		"keybindings": [
			{
				"command": "aiworkharness.addToChat",
				"key": "ctrl+l",
				"mac": "cmd+l",
				"when": "editorTextFocus"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "aiworkharness.implementTodo",
					"when": "false"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "aiworkharness-sidebar",
					"title": "AiWorkHarness",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"aiworkharness-sidebar": [
				{
					"type": "webview",
					"id": "aiworkharness.chatView",
					"name": "AiWorkHarness"
				}
			]
		},
		"configuration": [
			{
				"title": "%config.title%",
				"properties": {
					"aiworkharness.model": {
						"type": "string",
						"default": "auto",
						"description": "%config.model.description%"
					},
					"aiworkharness.maxResponseLength": {
						"type": "integer",
						"default": 0,
						"description": "%config.maxResponseLength.description%"
					},
					"aiworkharness.enableWorkspaceContext": {
						"type": "boolean",
						"default": true,
						"description": "%config.enableWorkspaceContext.description%"
					},
					"aiworkharness.enableFileReading": {
						"type": "boolean",
						"default": true,
						"description": "%config.enableFileReading.description%"
					},
					"aiworkharness.enableTerminalSuggestions": {
						"type": "boolean",
						"default": true,
						"description": "%config.enableTerminalSuggestions.description%"
					},
					"aiworkharness.systemPrompt": {
						"type": "string",
						"default": "You are a professional coding assistant extension named AiWorkHarness.",
						"description": "%config.systemPrompt.description%"
					},
					"aiworkharness.todoCodeLensEnabled": {
						"type": "boolean",
						"default": true,
						"description": "%config.todoCodeLensEnabled.description%"
					},
					"aiworkharness.executionMode": {
						"type": "string",
						"enum": [
							"local",
							"container"
						],
						"default": "local",
						"description": "%config.executionMode.description%"
					},
					"aiworkharness.browserExecutablePath": {
						"type": "string",
						"default": "",
						"description": "%config.browserExecutablePath.description%"
					},
					"aiworkharness.containerImage": {
						"type": "string",
						"default": "node:22-bookworm-slim",
						"description": "%config.containerImage.description%"
					},
					"aiworkharness.containerNetwork": {
						"type": "boolean",
						"default": false,
						"description": "%config.containerNetwork.description%"
					},
					"aiworkharness.containerMemoryMb": {
						"type": "integer",
						"minimum": 256,
						"maximum": 262144,
						"default": 4096,
						"description": "%config.containerMemoryMb.description%"
					},
					"aiworkharness.containerCpus": {
						"type": "number",
						"minimum": 0.25,
						"maximum": 128,
						"default": 2,
						"description": "%config.containerCpus.description%"
					}
				}
			}
		]
	},
	"scripts": {
		"build:worker": "node scripts/build-worker.cjs",
		"test:worker": "pnpm run build:worker && node scripts/worker-smoke.cjs",
		"worker": "node dist/worker.cjs serve",
		"eval:live": "node dist/worker.cjs evaluate",
		"vscode:prepublish": "pnpm run package",
		"compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"preview:ui": "node scripts/preview-webviews.cjs",
		"package": "pnpm run check-types && pnpm run lint && node esbuild.js --production && node scripts/build-worker.cjs",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
		"check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
		"lint": "eslint src",
		"test": "vscode-test",
		"test:unit": "vitest run --exclude src/agent/tools/browser.test.ts",
		"test:browser": "vitest run src/agent/tools/browser.test.ts --maxWorkers=1 --minWorkers=1",
		"vsix": "pnpm run package && pnpm exec vsce package --no-dependencies",
		"runtime:manifest": "node scripts/generate-runtime-manifest.cjs",
		"runtime:check": "node scripts/generate-runtime-manifest.cjs --check",
		"test:runtime": "node scripts/runtime-smoke.cjs",
		"test:eval": "vitest run src/agent/evaluations.test.ts",
		"test:host": "pnpm run compile-tests && node scripts/extension-host-test.cjs"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/pdf-parse": "^1.1.5",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/vscode": "~1.96.0",
		"@types/ws": "^8.18.2",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^4.1.0",
		"esbuild": "^0.28.1",
		"eslint": "^10.5.0",
		"js-yaml": "4.2.0",
		"jsdom": "26.1.0",
		"npm-run-all": "^4.1.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1",
		"vitest": "^2.1.9"
	},
	"dependencies": {
		"@huggingface/hub": "^2.13.2",
		"@huggingface/transformers": "^4.2.0",
		"@lydell/node-pty": "1.2.0-beta.15",
		"@modelcontextprotocol/sdk": "1.27.1",
		"ajv": "8.17.1",
		"lucide-react": "^1.21.0",
		"marked": "^18.0.5",
		"onnxruntime-node": "^1.27.0",
		"pdf-parse": "^2.4.5",
		"playwright-core": "1.63.0",
		"prosemirror-commands": "^1.7.2",
		"prosemirror-history": "^1.5.0",
		"prosemirror-inputrules": "^1.5.1",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-markdown": "^1.13.8",
		"prosemirror-model": "^1.25.12",
		"prosemirror-schema-list": "^1.5.1",
		"prosemirror-state": "^1.4.4",
		"prosemirror-view": "^1.42.5",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"sharp": "^0.35.2",
		"ws": "^8.22.2"
	}
}
